{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "modules-left": ["clock", "tray"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["custom/power", "custom/apps", "custom/wallpaper", "custom/colorpicker", "pulseaudio","bluetooth"],


  "hyprland/workspaces": {
      "format": "{icon}",
      "format-icons": {
          "active": "",
          "default": "",
          "empty": ""
      },
      "persistent-workspaces": {
          "*": [ 1,2,3 ]
      }
  },
  "clock": {
    "format": "{:%I:%M %p | %a-%d}",
    "min-length": 5,
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 6,
      "format": {
        "months": "<span alpha='100%'><b>{}</b></span>",
        "days": "<span alpha='90%'>{}</span>",
        "weekdays": "<span alpha='80%'><i>{}</i></span>",
        "today": "<span alpha='100%'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click": "mode"
    }
  },
  "bluetooth": {
      "format-on": "",
      "format-off": "BT-off",
      "format-disabled": "󰂲",
      "format-connected-battery": "{device_battery_percentage}% 󰂯",
      "format-alt": "{device_alias} 󰂯",
      "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
      "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
      "on-click-right": "blueman-manager"
  }, 
  "custom/colorpicker": {
      "format": "",
      "interval": "once",
      "on-click": "hyprpicker | wl-copy",
  },
  "custom/wallpaper": {
      "format": "󰸉 ",
      "interval": "once",
      "on-click": "waypaper",
  },
  "custom/apps": {
      "format": "   ",
      "interval": "once",
      "on-click": "rofi -show drun -theme ~/.config/rofi/apps.rasi",
  },
  "custom/power": {
      "format": " ⏻ ",
      "interval": "once",
      "on-click": "powermenu",
  },
  "memory": {
      "format": ""
  },
  "tray": {
      "icon-size": 14,
      "spacing": 10
  },
  "pulseaudio": {
    "format": "{volume}% ",
    "format-muted": "",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
      "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
      "headphones": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["", ""]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol"
  }
} 
