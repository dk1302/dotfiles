font-family = "GohuFont"
font-style-bold = false
font-size = "16"
adjust-cell-height = 5%
adjust-icon-height = -20%

keybind = ctrl+q=close_surface
keybind = ctrl+o=new_split:left
keybind = ctrl+h=goto_split:previous
keybind = ctrl+l=goto_split:next
keybind = ctrl+n=resize_split:left,700
keybind = ctrl+m=resize_split:right,700
